---
/** Four verified behaviours, one line each, above the capture specs in SpecsBand; the click story is in HowItWorks. */
import { features } from "../content/site";
---

<ul class="features">
  {features.map((feature) => (
    <li class="feature">
      <h3>{feature.title}</h3>
      <p>{feature.body}</p>
    </li>
  ))}
</ul>

<style>
  .features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 2rem;
  }
  .feature {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-strong);
  }
  .feature h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 0.4rem;
  }
  .feature p {
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  @media (max-width: 900px) {
    .features {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
  }
  @media (max-width: 520px) {
    .features {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }
  }
</style>
