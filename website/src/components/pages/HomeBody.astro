---
import FeatureGrid from "../FeatureGrid.astro";
import HowItWorks from "../HowItWorks.astro";
import Section from "../Section.astro";
import SpecsBand from "../SpecsBand.astro";
import InstallFlow from "../InstallFlow.astro";
---

<slot />
<HowItWorks />
<Section id="features" title="Stays out of the way">
  <FeatureGrid />
</Section>

<SpecsBand />
<Section id="get" title="Download, drag, open, allow, record">
  <InstallFlow />
</Section>

<style>
  :global(#get) {
    padding-bottom: calc(var(--section-y) * 1.6);
  }
</style>
