---
import Layout from "../layouts/Layout.astro";
import TextPage from "../components/pages/TextPage.astro";
import HelpContent from "../components/HelpContent.astro";
const toc = [
  { href: "#install", label: "Install" },
  { href: "#use", label: "Record" },
  { href: "#language", label: "Language" },
  { href: "#update", label: "Update" },
  { href: "#remove", label: "Remove" },
];
---

<Layout title="Help — install, record, update and remove RecordStuff" description="How to install RecordStuff on macOS, allow it to open, grant screen and system audio permission, record, update manually and remove it.">
  <TextPage title="Install, record, update, remove" toc={toc}>
    <HelpContent />
  </TextPage>
</Layout>
