---
import TextPage from "./TextPage.astro";
import ChecksumBlock from "../ChecksumBlock.astro";
import AppleMark from "../AppleMark.astro";
import { windowsBoundary, windowsSmartScreen, windowsUpcoming } from "../../content/site";
import { links, release } from "../../lib/release";

const windows = release.windows;
---

<TextPage title="Download RecordStuff" description={`Download the latest release for Apple silicon Macs${windows ? " and x64 Windows PCs" : ""}, view release details, and verify your download.`}>
  <p slot="meta" class="head-meta">
    <a class="link" href={release.notesUrl} target="_blank" rel="noopener noreferrer">v{release.version} release notes ↗</a>
  </p>

  <div class="platforms">
    <section class="platform-section platform-section--download" aria-labelledby="macos-title">
      <div class="platform-header">
        <h2 id="macos-title" class="platform-name">macOS</h2>
        <span class="platform-note dim">For Apple silicon Macs.</span>
      </div>
      <div class="download-action">
        <a class="btn btn-primary" href={release.dmgUrl} download={release.fileName}>
          <AppleMark /> Download for macOS
        </a>
        <p class="download-details dim">v{release.version} · {release.architectureLabel} · .dmg · {release.sizeLabel}</p>
      </div>
      <p class="platform-fine dim">
        Intel Macs are not supported. Not notarized by Apple: first installation or an update may require <a class="link" href="/help#open-anyway">Open Anyway</a>. No certificate is installed.
      </p>
    </section>

    <section class="platform-section" aria-labelledby="windows-title">
      <div class="platform-header">
        <h2 id="windows-title" class="platform-name">Windows</h2>
        <span class="platform-note dim">{windows ? "For x64 PCs. Not verified on Windows hardware." : "Not in this release."}</span>
      </div>
      {windows ? (
        <>
          <div class="download-action">
            <a class="btn btn-primary" href={windows.url} download={windows.name}>Download for Windows</a>
            <p class="download-details dim">v{release.version} · {windows.architectureLabel} · .exe installer · {windows.sizeLabel}</p>
          </div>
          <p class="platform-fine dim">
            {windowsBoundary} {windowsSmartScreen} See <a class="link" href="/help#windows">Windows help</a>. Windows on Arm and Linux are not supported.
          </p>
        </>
      ) : (
        <p class="platform-fine dim">
          {windowsUpcoming} {windowsBoundary} See the <a class="link" href={links.releases} target="_blank" rel="noopener noreferrer">GitHub releases page</a> and <a class="link" href="/help#windows">Windows help</a>. Windows on Arm and Linux are not supported.
        </p>
      )}
    </section>

    <section class="platform-section" aria-labelledby="verify-title">
      <div class="platform-header"><h2 id="verify-title" class="platform-name">Verify your download</h2></div>
      {windows ? (
        <>
          <h3 class="verify-name">macOS DMG</h3>
          <ChecksumBlock />
          <h3 class="verify-name">Windows installer</h3>
          <ChecksumBlock platform="windows" />
        </>
      ) : <ChecksumBlock />}
    </section>

    <section class="platform-section" aria-labelledby="older-title">
      <div class="platform-header"><h2 id="older-title" class="platform-name">Older versions</h2></div>
      <p class="muted">
        Every release, with its SHA256SUMS and release.json, is on the <a class="link" href={links.releases} target="_blank" rel="noopener noreferrer">GitHub releases page</a>. Updating is a manual download and replace; see <a class="link" href="/help#update">Help</a>{windows && <>, or <a class="link" href="/help#windows-update">Windows help</a> for the installer</>}.
      </p>
    </section>
  </div>
</TextPage>

<style>
  .head-meta {
    font-size: 0.85rem;
  }
  .platforms {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }
  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .platform-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .platform-name {
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }
  .platform-note,
  .platform-fine {
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .platform-fine { max-width: 720px; }
  .download-action { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .download-details { font-size: 0.85rem; line-height: 1.8; }
  .verify-name { font-weight: 500; font-size: 1rem; color: var(--fg); }
  .verify-name:not(:first-of-type) { margin-top: 1.5rem; }
  @media (max-width: 640px) {
    .platforms { gap: 3.5rem; }
    .platform-section { gap: 1.75rem; }
  }
</style>
