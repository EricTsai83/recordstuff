{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts"
  ],
  "exclude": ["scripts/fixtures/frame-cadence-renderer.ts"]
}
