{
  "name": "recordstuff",
  "version": "0.1.0",
  "description": "One menu bar button that records the main display with system audio.",
  "main": "./out/main/index.js",
  "author": "Eric Tsai",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite build && env -u ELECTRON_RUN_AS_NODE open -a \"$PWD/node_modules/electron/dist/Electron.app\" --args \"$PWD\"",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "icons": "node scripts/make-icons.mjs",
    "log": "tail -f \"$HOME/Library/Logs/recordstuff/recordstuff.log\"",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
