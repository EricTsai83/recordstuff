---
/**
 * The RecordStuff mark as it really appears: the tray ring with the red
 * recording dot inside, no square background. Inline SVG, sized by `size`.
 */
interface Props {
  size?: number;
  class?: string;
  /** Ring colour; defaults to the brand foreground so the mark reads the same
   * everywhere, including inside dimmed contexts such as the footer. */
  ring?: string;
}
const { size = 22, class: className, ring = "var(--fg)" } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 32 32"
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="12.5" fill="none" stroke={ring} stroke-width="3" />
  <circle cx="16" cy="16" r="6" fill="var(--rec, #ef4444)" />
</svg>
