---
interface Props { kind: "download" | "drag" | "open" | "record" | "screen" | "audio"; }
const { kind } = Astro.props;
// The ig-* classes name the parts InstallFlow moves as each glyph acts out its step; they add no styling of their own.
const bars = [[8, 28, 8], [16, 21, 22], [24, 13, 38], [32, 20, 24], [40, 9, 46], [48, 21, 22], [56, 28, 8]];
---
<svg viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === "download" && <>
    <path class="ig-arrow" d="M32 9v29m-9-9 9 9 9-9" />
    <path class="ig-tray" d="M10 39v13h44V39" />
    <path d="M16 57h32" opacity=".3" />
  </>}
  {kind === "drag" && <>
    <g class="ig-app">
      <rect x="3" y="6" width="21" height="21" rx="5" />
      <circle cx="13.5" cy="16.5" r="5" />
      <circle cx="13.5" cy="16.5" r="2.4" fill="var(--rec)" stroke="none" />
    </g>
    <g class="ig-folder">
      <path d="M30 32h10l5 5h16v22H30V32Z" />
      <path d="m41 53 5-11 5 11m-8-4h6" opacity=".65" />
    </g>
    <path class="ig-trail" d="M13 33v8q0 6 6 6h6m-4-4 4 4-4 4" stroke-dasharray="2 3" />
  </>}
  {kind === "open" && <>
    <g class="ig-app">
      <rect x="15" y="15" width="34" height="34" rx="8" />
      <circle cx="32" cy="32" r="9" />
      <circle class="ig-dot" cx="32" cy="32" r="4.3" fill="var(--rec)" stroke="none" />
    </g>
    <g class="ig-cursor">
      <g transform="translate(9 7)">
        <path d="M35 33v17l4.5-4.5 4.5 8.25 3.75-2.25-4.5-8.25 6.75-1.5L35 33Z" fill="var(--bg)" />
      </g>
    </g>
  </>}
  {kind === "record" && <>
    <g opacity=".45">
      <rect x="4" y="8" width="56" height="46" rx="3" />
      <path d="M4 24h56M10 16h8m4 0h5" />
      <rect x="49" y="13.5" width="7" height="4" rx=".5" />
      <path d="M58 14.5v2M51 15.5h3" />
    </g>
    <circle cx="39" cy="16" r="4.5" stroke-width="1.75" />
    <!-- The red dot inside the ring, as in the RecordStuff mark; InstallFlow's drawing lights it last. -->
    <circle class="ig-rec" cx="39" cy="16" r="2.1" fill="var(--rec)" stroke="none" />
    <path class="ig-arrow" d="M39 44V30m-5 5 5-5 5 5" />
  </>}
  {kind === "screen" && <><rect class="ig-frame" x="8" y="12" width="48" height="33" rx="2"/><path class="ig-mark" d="M24 53h16m-8-8v8M14 19h10m-10 0v9"/></>}
  {kind === "audio" && bars.map(([x, y, h], index) => <path class="ig-bar" style={`--b: ${index}`} d={`M${x} ${y}v${h}`} />)}
</svg>
