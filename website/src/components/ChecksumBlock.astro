---
/**
 * Verified release facts for one installer: filename, size, date, source
 * commit and SHA-256 with a copy button. `windows` renders the x64 installer
 * and must only be passed when the release carries one.
 */
import { links, release } from "../lib/release";

interface Props {
  class?: string;
  platform?: "macos" | "windows";
}
const { class: className, platform = "macos" } = Astro.props;
const windows = platform === "windows" ? release.windows : undefined;
if (platform === "windows" && !windows) throw new Error(`Release ${release.version} carries no Windows installer.`);
const file = windows
  ? { name: windows.name, size: windows.size, sizeLabel: windows.sizeLabel, sha256: windows.sha256, architecture: "x64 (64-bit Intel or AMD)", id: "win-sha256" }
  : { name: release.fileName, size: release.sizeBytes, sizeLabel: release.sizeLabel, sha256: release.sha256, architecture: "arm64 (Apple silicon)", id: "dmg-sha256" };
const rows = [
  { label: "File", value: file.name, mono: true },
  { label: "Size", value: `${file.size.toLocaleString("en")} bytes (${file.sizeLabel})` },
  { label: "Published", value: release.publishedLabel },
  { label: "Architecture", value: file.architecture },
];
---

<div class:list={["checksum", className]}>
  <dl class="facts">
    {
      rows.map((row) => (
        <div class="fact">
          <dt>{row.label}</dt>
          <dd class:list={[row.mono && "mono"]}>{row.value}</dd>
        </div>
      ))
    }
    <div class="fact">
      <dt>Source</dt>
      <dd>
        <a class="link mono" href={release.sourceCommitUrl} target="_blank" rel="noopener noreferrer">{release.sourceCommitShort}</a>
        <span class="dim"> · tag </span><span class="mono">{release.tag}</span>
      </dd>
    </div>
    <div class="fact fact--hash">
      <dt>SHA-256</dt>
      <dd>
        <code class="hash" id={file.id}>{file.sha256}</code>
        <button type="button" class="copy" data-copy-target={file.id} aria-describedby={`${file.id}-label`}>Copy</button>
        <span id={`${file.id}-label`} class="visually-hidden">SHA-256 to the clipboard</span>
        <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
      </dd>
    </div>
  </dl>
  {windows ? (
    <p class="verify-note">
      Verify after downloading, in PowerShell: <code>Get-FileHash $HOME\Downloads\{windows.name}</code>. It prints the hash in capitals; compare it, ignoring case, with this value and the installer's line in the published{" "}
      <a class="link" href={release.sha256sumsUrl} target="_blank" rel="noopener noreferrer">SHA256SUMS</a>.{" "}
      <a class="link" href={windows.recordUrl} target="_blank" rel="noopener noreferrer">release-win32-x64.json</a> records the same value with the source commit, version and size. The installer also carries a GitHub build-provenance attestation: <code>gh attestation verify {windows.name} --repo {links.repositorySlug}</code>.
    </p>
  ) : (
    <p class="verify-note">
      Verify after downloading: <code>shasum -a 256 ~/Downloads/{release.fileName}</code>. The published{" "}
      <a class="link" href={release.sha256sumsUrl} target="_blank" rel="noopener noreferrer">SHA256SUMS</a> and{" "}
      <a class="link" href={release.releaseJsonUrl} target="_blank" rel="noopener noreferrer">release.json</a> carry the same value.
    </p>
  )}
</div>

<script>
  // The button's visible text is its accessible name, so the change is read;
  // the status region repeats the outcome for readers that miss a relabel.
  document.querySelectorAll<HTMLButtonElement>("button[data-copy-target]").forEach((button) => {
    const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
    let reset: number | undefined;
    button.addEventListener("click", async () => {
      const target = document.getElementById(button.dataset.copyTarget ?? "");
      if (!target) return;
      let announcement: string;
      try {
        await navigator.clipboard.writeText(target.textContent ?? "");
        button.textContent = "Copied";
        announcement = "SHA-256 copied to the clipboard.";
      } catch {
        // No clipboard access: leave the hash selected so one keystroke copies it.
        window.getSelection()?.selectAllChildren(target);
        button.textContent = "Select to copy";
        announcement = "Clipboard unavailable; the SHA-256 is selected, copy it with the keyboard.";
      }
      if (status) status.textContent = announcement;
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.textContent = "Copy";
        if (status) status.textContent = "";
      }, 1600);
    });
  });
</script>

<style>
  .checksum {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .fact--hash {
    grid-column: 1 / -1;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  dd {
    font-size: 0.92rem;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .fact--hash dd { display: flex; align-items: center; gap: 0.75rem; }
  .hash {
    min-width: 0;
    display: inline-block;
    font-size: 0.8rem;
    color: var(--fg-muted);
    flex: 1;
    word-break: break-all;
  }
  .copy {
    min-height: 44px;
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--fg-muted);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .copy:hover {
    color: var(--fg);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .verify-note {
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--fg-dim);
  }
  .verify-note code {
    font-size: 0.75rem;
    color: var(--fg-muted);
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .fact--hash dd { flex-direction: column; align-items: flex-start; }
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
