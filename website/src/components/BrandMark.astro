---
/**
 * The RecordStuff mark as it really appears: the tray ring with the red
 * recording dot inside, no square background. Inline SVG, sized by `size`.
 * The ring is the brand foreground, so the mark reads the same everywhere,
 * including inside dimmed contexts such as the footer.
 */
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 32 32"
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="12.5" fill="none" stroke="var(--fg)" stroke-width="3" />
  <circle cx="16" cy="16" r="6" fill="var(--rec)" />
</svg>
