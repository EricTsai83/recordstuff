{
  "name": "recordstuff",
  "version": "3.1.1",
  "description": "One menu bar button that records the main display with system audio.",
  "main": "./out/main/index.js",
  "author": "Eric Tsai",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite build && env -u ELECTRON_RUN_AS_NODE open -a \"$PWD/node_modules/electron/dist/Electron.app\" --args \"$PWD\"",
    "start:app": "node scripts/start-app.mjs",
    "open:app": "node scripts/start-app.mjs --open",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed && vitest run tests/source-boundaries.test.ts tests/style-guard.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:native && pnpm lint:native && pnpm fmt:native:check && pnpm build && node scripts/native-load.mjs",
    "test:native": "cargo test --manifest-path native/capture/Cargo.toml --lib -- --skip core::tests && cargo test --manifest-path native/capture/Cargo.toml --lib -- --test-threads=1 core::tests",
    "lint:native": "cargo clippy --manifest-path native/capture/Cargo.toml --lib --tests -- -D warnings",
    "fmt:native": "cargo fmt --manifest-path native/capture/Cargo.toml",
    "fmt:native:check": "cargo fmt --manifest-path native/capture/Cargo.toml --check",
    "icons": "node scripts/make-icons.mjs",
    "log": "tail -F \"$HOME/Library/Logs/recordstuff/recordstuff.log\"",
    "probe": "node scripts/probe-recording.mjs",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-recording.mts",
    "acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-hotkey.mts",
    "acceptance:lifecycle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-lifecycle.mts",
    "acceptance:notification": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-notification.mts",
    "acceptance:settings-shortcut": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-settings-shortcut.mts",
    "acceptance:settings": "playwright test --project=background components settings-",
    "acceptance:settings-native": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-settings-native.mts",
    "acceptance:window-drag": "pnpm build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-window-drag.mts",
    "acceptance:cleanup-audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-cleanup-audit.mts",
    "matrix": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-matrix.mts",
    "measure:finalization": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure-finalization.mts",
    "diagnose:frames": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnose-frames.mts",
    "diagnose:pipeline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnose-pipeline.mts",
    "diagnose:profile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnose-profile.mts",
    "measure:cpu": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure-cpu.mts",
    "measure:thumbnails": "playwright test --project=measure",
    "bench:publication": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench-publication.mts",
    "bench:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench-export.mts",
    "bench:editable": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench-editable.mts",
    "dist:mac": "node scripts/start-app.mjs --dmg",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "audio:quality": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audio-quality.mts",
    "signing:create": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-signing-identity.mts",
    "release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release.mts",
    "site:dev": "pnpm --dir website dev",
    "site:build": "pnpm --dir website build",
    "site:check": "pnpm --dir website test && pnpm --dir website check",
    "site:manifest": "pnpm --dir website manifest",
    "site:screenshots": "pnpm --dir website screenshots",
    "acceptance:updates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-updates.mts",
    "acceptance:recipe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-recipe.mts",
    "acceptance:regression": "pnpm check && pnpm test:ui",
    "acceptance:shortcut": "pnpm build && playwright test --project=background shortcut-integration",
    "acceptance:shortcut-native": "pnpm build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-shortcut-native.mts",
    "acceptance:shortcut-layout": "pnpm build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-shortcut-layout.mts",
    "acceptance:quit-dialog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-quit-dialog.mts",
    "acceptance:controlled": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-controlled.mts",
    "acceptance:playback": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-playback.mts",
    "acceptance:player": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-player.mts",
    "preview:ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/preview-ui.mts",
    "acceptance:tray": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-tray.mts",
    "acceptance:studio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-studio.mts",
    "acceptance:capture-settings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-capture-settings.mts",
    "acceptance:editor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-editor.mts",
    "native:input": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/native-input.mts",
    "prep:edit-view": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/edit-view-prep.mts",
    "test:ui": "playwright test --project=background",
    "test:scope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-scope.mts",
    "test:ui:drills": "playwright test --project=drills"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
