---
import TextPage from "./TextPage.astro";
import ChecksumBlock from "../ChecksumBlock.astro";
import PlatformSwitch from "../PlatformSwitch.astro";
import AppleMark from "../AppleMark.astro";
import WindowsMark from "../WindowsMark.astro";
import { windowsBoundary, windowsSmartScreen, windowsUpcoming } from "../../content/site";
import { links, release } from "../../lib/release";

const windows = release.windows;
---

<TextPage title="Download RecordStuff" description={`Version ${release.version}, released ${release.publishedLabel}.`}>
  <p slot="meta" class="head-meta">
    <a class="link" href={release.notesUrl} target="_blank" rel="noopener noreferrer">v{release.version} release notes ↗</a>
  </p>

  <PlatformSwitch macIds={["macos-title"]} windowsIds={["windows-title"]} />
  <div class="platforms">
    <section class="platform-section" aria-labelledby="macos-title" data-only="mac">
      <div class="platform-header">
        <h2 id="macos-title" class="platform-name">macOS</h2>
        <span class="platform-note dim">For Apple silicon Macs.</span>
      </div>
      <div class="download-action">
        <a class="btn btn-primary" href={release.dmgUrl} download={release.fileName}>
          <AppleMark /> Download for macOS
        </a>
        <p class="download-details dim">v{release.version} · {release.architectureLabel} · .dmg · {release.sizeLabel}</p>
      </div>
      <p class="platform-fine dim">
        Not notarized by Apple, so the first launch may need <a class="link" href="/help#open-anyway">Open Anyway</a>. Intel Macs are not supported.
      </p>
    </section>

    <section class="platform-section" aria-labelledby="windows-title" data-only="windows">
      <div class="platform-header">
        <h2 id="windows-title" class="platform-name">Windows</h2>
        <span class="platform-note dim">{windows ? "For x64 PCs. Not verified on Windows hardware." : "Not in this release."}</span>
      </div>
      {windows ? (
        <>
          <div class="download-action">
            <a class="btn btn-primary" href={windows.url} download={windows.name}><WindowsMark size={16} /> Download for Windows</a>
            <p class="download-details dim">v{release.version} · {windows.architectureLabel} · .exe installer · {windows.sizeLabel}</p>
          </div>
          <p class="platform-fine dim">
            {windowsBoundary} {windowsSmartScreen} See <a class="link" href="/help#windows">Windows help</a>.
          </p>
        </>
      ) : (
        <p class="platform-fine dim">
          {windowsUpcoming} {windowsBoundary} See <a class="link" href="/help#windows">Windows help</a>.
        </p>
      )}
    </section>

    <section class="platform-section" aria-labelledby="verify-title">
      <div class="platform-header"><h2 id="verify-title" class="platform-name">Verify your download</h2></div>
      <div class="verify-platform" data-only="mac">
        {windows && <h3 class="verify-name">macOS DMG</h3>}
        <ChecksumBlock />
      </div>
      {windows && (
        <div class="verify-platform" data-only="windows">
          <h3 class="verify-name">Windows installer</h3>
          <ChecksumBlock platform="windows" />
        </div>
      )}
    </section>

    <section class="platform-section" aria-labelledby="older-title">
      <div class="platform-header"><h2 id="older-title" class="platform-name">Older versions</h2></div>
      <p class="muted">
        Every release is on <a class="link" href={links.releases} target="_blank" rel="noopener noreferrer">GitHub Releases</a>. To update, see <a class="link" href="/help#update" data-only="mac">Help</a>{windows && <a class="link" href="/help#windows-update" data-only="windows">Help</a>}.
      </p>
    </section>
  </div>
</TextPage>

<style>
  .head-meta {
    font-size: 0.85rem;
  }
  .platforms {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .platform-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .platform-name {
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    /* The home page links to these headings; clear the sticky nav as .prose h2 does. */
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .platform-note,
  .platform-fine {
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .platform-fine { max-width: 720px; }
  .download-action { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .download-details { font-size: 0.85rem; line-height: 1.8; }
  .verify-platform { display: flex; flex-direction: column; gap: 1.5rem; }
  .verify-name { font-weight: 500; font-size: 1rem; color: var(--fg); }
  /* With the switch, the chosen platform is already named above: drop the per-platform names. */
  :global(:root[data-platform]) .platform-section[data-only] .platform-header,
  :global(:root[data-platform]) .verify-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .platforms { gap: 2.75rem; }
    .platform-section { gap: 1.25rem; }
  }
</style>
