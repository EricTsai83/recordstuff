---
/** Specification strip in the style of a "bring your own" block: title, equal cells with icon + label + mono value, then a check-marked line. Values come from README.md and the release manifest. */
import { release } from "../lib/release";
const cells = [
  { label: "Output", value: "H.264 / AAC MP4", icon: `<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M10 9.5v5l4-2.5z" fill="currentColor" stroke="none"/>` },
  { label: "Resolution", value: "4K or source", icon: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v16"/>` },
  { label: "Frame rate", value: "30 or 60 fps", icon: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>` },
  { label: "Audio", value: "256 kbps AAC", icon: `<path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4"/>` },
  { label: "Shortcut", value: "⌘⇧1", icon: `<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10"/>` },
  { label: "Installer", value: `${release.sizeLabel} · arm64`, icon: `<path d="M12 3v11m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>` },
];
const checks = ["Free and MIT licensed.", "Verified on macOS 26, Apple silicon."];
---

<section class="specs container" aria-labelledby="specs-title" data-reveal>
  <h2 id="specs-title" class="section-title">What you get</h2>
  <ul class="cells">
    {cells.map((cell) => (
      <li class="cell">
        <span class="cell-label">
          <svg class="cell-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={cell.icon} /></svg>
          {cell.label}
        </span>
        <span class="cell-value mono">{cell.value}</span>
      </li>
    ))}
  </ul>
  <ul class="checks">
    {checks.map((c) => (
      <li><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="var(--ok)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4 4L19 7"/></svg><span>{c}</span></li>
    ))}
  </ul>
</section>

<style>
  .specs {
    padding: var(--section-y) 32px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .section-title {
    margin-bottom: calc(var(--section-head-gap) - 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.15;
  }
  .cells {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    overflow: hidden;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1.15rem 1rem;
    border-right: 1px solid var(--border-strong);
    min-width: 0;
  }
  .cell:last-child {
    border-right: 0;
  }
  .cell-icon {
    flex-shrink: 0;
    color: var(--fg);
  }
  .cell-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--fg-dim);
  }
  .cell-value {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--fg);
    white-space: nowrap;
  }
  .checks {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-strong);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .checks li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (max-width: 1240px) {
    .cells {
      grid-template-columns: repeat(3, 1fr);
    }
    .cell:nth-child(3n) {
      border-right: 0;
    }
    .cell:nth-child(-n + 3) {
      border-bottom: 1px solid var(--border-strong);
    }
  }
  @media (max-width: 640px) {
    .specs {
      padding: var(--section-y) 20px;
    }
    .cell-value {
      white-space: normal;
    }
    .cells {
      grid-template-columns: 1fr 1fr;
    }
    .cell:nth-child(3n) {
      border-right: 1px solid var(--border-strong);
    }
    .cell:nth-child(2n) {
      border-right: 0;
    }
    .cell:nth-child(-n + 3) {
      border-bottom: 0;
    }
    .cell:nth-child(-n + 4) {
      border-bottom: 1px solid var(--border-strong);
    }
  }
</style>
