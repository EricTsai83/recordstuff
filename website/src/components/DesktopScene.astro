---
/**
 * Inline SVG of a low-poly Mac desktop at a campsite that tells the product
 * story on a 27-second loop, following the app's default click (2026-10-04: a
 * click on the icon opens its menu): three seconds of stillness so the viewer
 * notices the screen first; the camera pushes in on the top-right corner as
 * the pointer arrives and clicks the ring; the menu the app shows while idle
 * drops down (tray-model.ts: Start recording with its shortcut, Open
 * RecordStuff, Show last recording, Quit RecordStuff; a plain Ready line is
 * left to the tooltip) and the pointer chooses Start recording; a
 * brief hourglass while capture is prepared, then a stopwatch while a faint
 * 3, 2, 1 counts down at the screen's top-right (the digit leaves 0.3 s early)
 * and the pointer moves away; then the filled dot with "REC" beside it and the
 * status item shifts left to make room (exactly what the app does: the
 * template image swaps and the title is set; nothing blinks); the camera pulls
 * back; a callout arrow points at the recording dot and says "Click again,
 * then choose Stop", held for three seconds so it can be read; the camera
 * pushes in again, the pointer clicks the dot, the recording menu drops down
 * and the pointer chooses Stop; the hourglass shows while saving, and half a
 * second later the "Saved <timestamp>.mp4" notification pops in, the same beat
 * the app waits before posting it (SAVED_NOTIFICATION_DELAY_MS). The hero
 * pauses the loop while the scene is off-screen and offers a button that
 * pauses it; prefers-reduced-motion shows the final frame. Cost:
 * transform/opacity on a handful of nodes, composited by the browser. Zero
 * image requests.
 */
import Landscape from "./scenes/FacetLandscape.astro";
import { generateStars, starsToSvg } from "../lib/stars";

const stars = starsToSvg(generateStars({ width: 1600, skyBottom: 520, seed: 11 }));
const savedFile = "2026-09-20 21-14-33.mp4";
---

<svg
  class="ds"
  viewBox="0 0 1600 900"
  role="img"
  aria-label="Animation: the pointer clicks the RecordStuff ring in the macOS menu bar and chooses Start recording from its menu; a stopwatch replaces the ring while a faint 3, 2, 1 counts down in the top-right corner of the screen, then a filled dot with REC beside it shows the recording; a callout says to click again and choose Stop; the pointer opens the menu again, chooses Stop, and a notification says the recording was saved."
>
  <defs>
    <clipPath id="ds-clip"><rect width="1600" height="900" rx="18" /></clipPath>
  </defs>
  <g clip-path="url(#ds-clip)">
   <g class="ds-camera">
    <Landscape>
      <g slot="stars"><Fragment set:html={stars} /></g>
    </Landscape>

    <!-- menu bar -->
    <rect width="1600" height="52" class="ds-bar" />
    <g transform="translate(12 0)">
      <!-- Bar items share the bar's centre line (y 26): the shapes by geometry, the labels (y 26.75,
           central baseline) and this logo by their measured ink, capitals for text. -->
      <path transform="translate(28 14.55) scale(0.95)" d="M17.6 12.7c-.1-2.9 2.4-4.3 2.5-4.4-1.4-2-3.5-2.3-4.2-2.3-1.8-.2-3.5 1-4.4 1s-2.3-1-3.8-1c-2 0-3.8 1.2-4.8 2.9-2.1 3.6-.5 8.9 1.5 11.8 1 1.4 2.2 3 3.7 2.9 1.5-.1 2-1 3.8-1s2.3 1 3.8.9c1.6 0 2.6-1.4 3.6-2.8 1.1-1.6 1.6-3.2 1.6-3.3-.1 0-3.2-1.2-3.3-4.7zM14.7 4.1c.8-1 1.4-2.4 1.2-3.8-1.2 0-2.6.8-3.5 1.8-.8.9-1.4 2.3-1.2 3.7 1.3.1 2.7-.7 3.5-1.7z" class="ds-bar-fill" />
      <text x="62" y="26.75" class="ds-bar-text ds-bold">Finder</text>
      <text x="134" y="26.75" class="ds-bar-text">File</text>
      <text x="180" y="26.75" class="ds-bar-text">Edit</text>
      <text x="230" y="26.75" class="ds-bar-text">View</text>
      <text x="288" y="26.75" class="ds-bar-text">Go</text>
      <text x="330" y="26.75" class="ds-bar-text">Window</text>
      <text x="418" y="26.75" class="ds-bar-text">Help</text>
    </g>

    <!-- RecordStuff status item: ring while idle; hourglass while preparing or saving; stopwatch during the countdown; filled dot plus the title "REC" while recording (the item widens leftwards, as macOS does). Shapes follow scripts/make-icons.mjs. -->
    <g class="ds-rs">
      <circle cx="1370" cy="26" r="8.5" class="ds-rs-ring" />
      <g class="ds-rs-busy" transform="translate(1361 17) scale(18)">
        <rect x="0.22" y="0.10" width="0.56" height="0.09" />
        <rect x="0.22" y="0.81" width="0.56" height="0.09" />
        <polygon points="0.25,0.19 0.375,0.5 0.25,0.81 0.34,0.81 0.465,0.5 0.34,0.19" />
        <polygon points="0.75,0.19 0.625,0.5 0.75,0.81 0.66,0.81 0.535,0.5 0.66,0.19" />
      </g>
      <g class="ds-rs-watch" transform="translate(1361 17) scale(18)">
        <circle cx="0.5" cy="0.56" r="0.255" fill="none" stroke="var(--ds-bar-fg)" stroke-width="0.11" />
        <rect x="0.40" y="0.05" width="0.20" height="0.09" />
        <rect x="0.46" y="0.13" width="0.08" height="0.14" />
        <rect x="0.46" y="0.40" width="0.08" height="0.16" />
        <circle cx="0.5" cy="0.56" r="0.07" />
      </g>
      <circle cx="1370" cy="26" r="8.5" class="ds-rs-dot" />
      <text x="1386" y="26.75" class="ds-bar-text ds-rs-title">REC</text>
    </g>

    <!-- countdown digit: only the digit, 28% white with a faint outline, near the top-right of the screen; no box -->
    <g class="ds-digits">
      <text x="1469" y="175" class="ds-digit ds-digit-3">3</text>
      <text x="1469" y="175" class="ds-digit ds-digit-2">2</text>
      <text x="1469" y="175" class="ds-digit ds-digit-1">1</text>
    </g>
    <rect x="1392" y="19" width="26" height="14" rx="3" fill="none" stroke="var(--ds-bar-fg)" stroke-width="1.8" />
    <rect x="1419" y="23" width="2.5" height="6" rx="1" fill="var(--ds-bar-fg)" />
    <rect x="1394.5" y="21.5" width="17" height="9" fill="var(--ds-bar-fg)" />
    <text x="1436" y="26.75" class="ds-bar-text">Sat 20 Sep  21:14</text>

    <!-- callout: how to stop, drawn by hand (two slightly offset strokes, open arrowhead, handwriting font, no box) -->
    <g class="ds-callout">
      <g class="ds-sketch">
        <!-- from the middle of the sentence, curving up to the recording dot at (1322, 26); the tip stops just under it -->
        <path d="M1298 192 C1276 156 1288 104 1310 66 C1315 57 1319 50 1322 44" />
        <path d="M1301 194 C1279 158 1291 106 1313 68 C1318 59 1322 52 1325 46" class="ds-sketch-2" />
        <path d="M1309 49 C1314 47 1319 45 1322 44 C1323 49 1324 53 1326 58" />
      </g>
      <text x="1292" y="250" text-anchor="middle" class="ds-callout-text" transform="rotate(-9 1292 250)">Click again, then choose Stop</text>
    </g>

    <!-- saved notification -->
    <g class="ds-toast">
      <rect width="396" height="76" rx="16" class="ds-toast-bg" />
      <g transform="translate(20 20)">
        <circle cx="18" cy="18" r="13" fill="none" stroke="var(--ds-bar-fg)" stroke-width="3" />
        <circle cx="18" cy="18" r="6.5" fill="var(--rec)" />
      </g>
      <text x="72" y="34" class="ds-toast-title">RecordStuff</text>
      <text x="72" y="56" class="ds-toast-body">Saved {savedFile}</text>
      <text x="372" y="30" class="ds-toast-time" text-anchor="end">now</text>
    </g>

    <!-- the status item's menus, as tray-model.ts builds them while idle and while recording; the highlight is the item under the pointer -->
    <g class="ds-menu ds-menu-idle" transform="translate(1330 56)">
      <rect width="250" height="118" rx="9" class="ds-menu-bg" />
      <rect x="5" y="5" width="240" height="22" rx="5" class="ds-menu-hl" />
      <text x="14" y="16" class="ds-menu-text">Start recording</text>
      <text x="236" y="16" class="ds-menu-key">⇧⌘1</text>
      <line x1="12" x2="238" y1="32" y2="32" class="ds-menu-sep" />
      <text x="14" y="48" class="ds-menu-text">Open RecordStuff</text>
      <text x="236" y="48" class="ds-menu-key">⌥⌘,</text>
      <text x="14" y="70" class="ds-menu-text">Show last recording</text>
      <line x1="12" x2="238" y1="86" y2="86" class="ds-menu-sep" />
      <text x="14" y="102" class="ds-menu-text">Quit RecordStuff</text>
    </g>
    <g class="ds-menu ds-menu-rec" transform="translate(1312 56)">
      <rect width="250" height="118" rx="9" class="ds-menu-bg" />
      <rect x="5" y="5" width="240" height="22" rx="5" class="ds-menu-hl" />
      <text x="14" y="16" class="ds-menu-text">Stop</text>
      <text x="236" y="16" class="ds-menu-key">⇧⌘1</text>
      <line x1="12" x2="238" y1="32" y2="32" class="ds-menu-sep" />
      <text x="14" y="48" class="ds-menu-text">Open RecordStuff</text>
      <text x="236" y="48" class="ds-menu-key">⌥⌘,</text>
      <text x="14" y="70" class="ds-menu-text">Show last recording</text>
      <line x1="12" x2="238" y1="86" y2="86" class="ds-menu-sep" />
      <text x="14" y="102" class="ds-menu-text">Quit RecordStuff</text>
    </g>
    <!-- pointer -->
    <g class="ds-pointer">
      <path d="M0 0 L0 22 L6 17 L10 26 L14 24 L10 15 L17 15 Z" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linejoin="round" />
    </g>
   </g>
  </g>
</svg>

<style>
  .ds {
    width: 100%;
    height: auto;
    display: block;
    --ds-bar-bg: rgba(12, 12, 20, 0.72);
    --ds-bar-fg: #f4f4f5;
    --ds-font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    --story: 27s; /* 3 s idle, a menu to start from, slow camera moves, a 3 s countdown, a 3 s beat to read the callout, a menu to stop from, a ~0.5 s beat before the notification, rest on the saved frame */
  }
  .ds :global(.st) {
    fill: #e6ebf2;
    opacity: var(--o, 0.6);
  }
  .ds :global(.st-spark) {
    stroke: #fff;
    stroke-width: 0.7;
    opacity: calc(var(--o, 0.6) * 0.7);
  }
  /* Camera: the whole desktop pushes in toward the menu-bar icon on each click. */
  .ds-camera {
    transform-box: view-box;
    /* Anchored at the screen's top-right corner: the whole corner block grows together and the icon sits inside the thicker bar. */
    transform-origin: 1600px 0px;
    animation: ds-camera var(--story) cubic-bezier(0.45, 0, 0.15, 1) infinite;
  }
  /* Ambient flicker while the scene is on screen; [data-offscreen] pauses it with everything else. */
  .ds :global(.ds-flame) {
    transform-origin: 0 0;
    animation: ds-flicker 0.9s ease-in-out infinite alternate;
  }
  .ds-bar {
    fill: var(--ds-bar-bg);
  }
  .ds-bar-fill {
    fill: var(--ds-bar-fg);
  }
  .ds-bar-text {
    fill: var(--ds-bar-fg);
    font-family: var(--ds-font);
    font-size: 15px;
    dominant-baseline: central;
  }
  .ds-bold {
    font-weight: 700;
  }
  .ds-rs {
    animation: ds-rs-shift var(--story) linear infinite;
  }
  .ds-rs-ring {
    fill: none;
    stroke: var(--ds-bar-fg);
    stroke-width: 2.4;
    animation: ds-ring var(--story) linear infinite;
  }
  /* macOS tints the template image itself, so the filled dot is the bar's foreground colour, not red. */
  .ds-rs-dot {
    fill: var(--ds-bar-fg);
    opacity: 0;
    animation: ds-dot var(--story) linear infinite;
  }
  .ds-rs-title {
    font-weight: 600;
    opacity: 0;
    animation: ds-dot var(--story) linear infinite;
  }
  .ds-rs-busy,
  .ds-rs-watch {
    fill: var(--ds-bar-fg);
    opacity: 0;
  }
  .ds-rs-busy {
    animation: ds-busy var(--story) linear infinite;
  }
  .ds-rs-watch {
    animation: ds-watch var(--story) linear infinite;
  }
  .ds-digit {
    fill: rgba(255, 255, 255, 0.28);
    stroke: rgba(0, 0, 0, 0.1);
    stroke-width: 2;
    paint-order: stroke fill;
    font-family: ui-rounded, "SF Pro Rounded", var(--ds-font);
    font-size: 120px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-anchor: middle;
    dominant-baseline: central;
    opacity: 0;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.14));
  }
  .ds-digit-3 { animation: ds-digit-3 var(--story) linear infinite; }
  .ds-digit-2 { animation: ds-digit-2 var(--story) linear infinite; }
  .ds-digit-1 { animation: ds-digit-1 var(--story) linear infinite; }
  .ds-toast {
    opacity: 0;
    transform: translate(1176px, 40px);
    animation: ds-toast var(--story) linear infinite;
  }
  .ds-callout {
    opacity: 0;
    animation: ds-callout var(--story) linear infinite;
  }
  /* The arrow grows from its tip at the recording dot, so it gets longer and
     bolder while the tip stays on the menu bar item. */
  .ds-sketch {
    transform-box: view-box;
    transform-origin: 1322px 26px;
    transform: scale(1.1);
  }
  .ds-sketch path {
    fill: none;
    stroke: #f5f5f4;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ds-sketch .ds-sketch-2 {
    stroke-width: 2.5;
    opacity: 0.55;
  }
  .ds-callout-text {
    fill: #f5f5f4;
    font-family: "Kalam", "Comic Sans MS", "Bradley Hand", cursive;
    font-size: 40px;
    font-weight: 700;
  }
  .ds-toast-bg {
    fill: rgba(40, 40, 52, 0.96);
    stroke: rgba(255, 255, 255, 0.14);
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.45));
  }
  .ds-toast-title {
    fill: #f4f4f5;
    font-family: var(--ds-font);
    font-size: 15px;
    font-weight: 700;
  }
  .ds-toast-body {
    fill: rgba(255, 255, 255, 0.78);
    font-family: var(--ds-font);
    font-size: 14px;
  }
  .ds-toast-time {
    fill: rgba(255, 255, 255, 0.45);
    font-family: var(--ds-font);
    font-size: 12px;
  }
  .ds-menu {
    opacity: 0;
  }
  .ds-menu-idle { animation: ds-menu-idle var(--story) linear infinite; }
  .ds-menu-rec { animation: ds-menu-rec var(--story) linear infinite; }
  .ds-menu-bg {
    fill: rgba(36, 36, 44, 0.95);
    stroke: rgba(255, 255, 255, 0.16);
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.45));
  }
  .ds-menu-hl {
    fill: #0a64d8;
    opacity: 0;
  }
  .ds-menu-idle .ds-menu-hl { animation: ds-menu-idle-hl var(--story) linear infinite; }
  .ds-menu-rec .ds-menu-hl { animation: ds-menu-rec-hl var(--story) linear infinite; }
  .ds-menu-text,
  .ds-menu-key {
    fill: #f4f4f5;
    font-family: var(--ds-font);
    font-size: 15px;
    dominant-baseline: central;
  }
  .ds-menu-key {
    fill: rgba(255, 255, 255, 0.55);
    font-size: 14px;
    text-anchor: end;
  }
  .ds-menu-sep {
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1;
  }
  .ds-pointer {
    transform: translate(1040px, 520px);
    animation: ds-pointer var(--story) cubic-bezier(0.45, 0, 0.15, 1) infinite;
  }

  @keyframes ds-pointer {
    0%, 11.11% { transform: translate(1040px, 520px) scale(1); }
    16.56%, 18.81% { transform: translate(1372px, 30px) scale(1); }
    19.26% { transform: translate(1372px, 30px) scale(0.85); }
    19.70% { transform: translate(1372px, 30px) scale(1); }
    22.22%, 23.07% { transform: translate(1396px, 69px) scale(1); }
    23.52% { transform: translate(1396px, 69px) scale(0.85); }
    23.96%, 24.44% { transform: translate(1396px, 69px) scale(1); }
    30.74%, 55.56% { transform: translate(1180px, 330px) scale(1); }
    60%, 61.04% { transform: translate(1324px, 30px) scale(1); }
    61.48% { transform: translate(1324px, 30px) scale(0.85); }
    61.93% { transform: translate(1324px, 30px) scale(1); }
    64.07%, 65.11% { transform: translate(1378px, 69px) scale(1); }
    65.56% { transform: translate(1378px, 69px) scale(0.85); }
    66%, 66.67% { transform: translate(1378px, 69px) scale(1); }
    73.70%, 100% { transform: translate(1040px, 520px) scale(1); }
  }
  /*
    Timeline (seconds of 27): 0–3 idle; 3–4.5 pointer in, camera pushes in 3.5–4.9; 5.2 click on the ring and
    the idle menu drops down; 5.3–6.0 pointer to Start recording, which highlights; 6.35 choose it, the menu
    closes; 6.5–6.8 hourglass while capture is prepared; 6.8–9.8 stopwatch and the corner digits 3, 2, 1 (the
    last fading out 0.3 s before capture) while the pointer moves away; 9.8 REC; pull back 10.2–11.7; 11.9–12.3
    the callout "Click again, then choose Stop" is drawn; a 3 s beat to read it; 15–16.2 camera pushes in and
    the pointer returns; 16.6 click on the dot and the recording menu drops down; 17.3 pointer on Stop; 17.7
    choose it, hourglass while saving to 18.1, then a ~0.5 s beat before the notification pops in by 18.95,
    matching the app's delay; pull back 18.3–19.7 while the pointer leaves; 25.7 notification fades; rest to 27.
  */
  @keyframes ds-camera {
    0%, 12.96% { transform: scale(1); }
    18.30%, 37.78% { transform: scale(2.1); }
    43.33%, 55.56% { transform: scale(1); }
    60%, 67.78% { transform: scale(2.1); }
    72.96%, 100% { transform: scale(1); }
  }
  @keyframes ds-menu-idle {
    0%, 19.26% { opacity: 0; }
    19.30%, 23.96% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }
  @keyframes ds-menu-idle-hl {
    0%, 21.67% { opacity: 0; }
    21.85%, 23.96% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }
  @keyframes ds-menu-rec {
    0%, 61.48% { opacity: 0; }
    61.52%, 66% { opacity: 1; }
    66.04%, 100% { opacity: 0; }
  }
  @keyframes ds-menu-rec-hl {
    0%, 63.52% { opacity: 0; }
    63.70%, 66% { opacity: 1; }
    66.04%, 100% { opacity: 0; }
  }
  @keyframes ds-dot {
    0%, 36.22% { opacity: 0; }
    36.30%, 66% { opacity: 1; }
    66.04%, 100% { opacity: 0; }
  }
  @keyframes ds-ring {
    0%, 23.96% { opacity: 1; }
    24%, 67.04% { opacity: 0; }
    67.07%, 100% { opacity: 1; }
  }
  @keyframes ds-busy {
    0%, 23.96% { opacity: 0; }
    24%, 25.19% { opacity: 1; }
    25.22%, 66% { opacity: 0; }
    66.04%, 67.04% { opacity: 1; }
    67.07%, 100% { opacity: 0; }
  }
  @keyframes ds-watch {
    0%, 25.19% { opacity: 0; }
    25.22%, 36.22% { opacity: 1; }
    36.30%, 100% { opacity: 0; }
  }
  /* 120 ms fade in, 150 ms crossfades, 120 ms fade out ending 0.3 s before REC. */
  @keyframes ds-digit-3 {
    0%, 25.11% { opacity: 0; }
    25.56%, 28.56% { opacity: 1; }
    29.07%, 100% { opacity: 0; }
  }
  @keyframes ds-digit-2 {
    0%, 28.56% { opacity: 0; }
    29.07%, 32.22% { opacity: 1; }
    32.78%, 100% { opacity: 0; }
  }
  @keyframes ds-digit-1 {
    0%, 32.22% { opacity: 0; }
    32.78%, 34.67% { opacity: 1; }
    35.11%, 100% { opacity: 0; }
  }
  /* The status item grows by the width of "REC"; macOS pushes it left of the items that follow. */
  @keyframes ds-rs-shift {
    0%, 36.22% { transform: translateX(0); }
    36.30%, 66% { transform: translateX(-48px); }
    66.04%, 100% { transform: translateX(0); }
  }
  @keyframes ds-callout {
    0%, 44.07% { opacity: 0; }
    45.56%, 55.19% { opacity: 1; }
    56.30%, 100% { opacity: 0; }
  }
  @keyframes ds-toast {
    0%, 68.89% { opacity: 0; transform: translate(1176px, 40px); }
    70.19%, 93.70% { opacity: 1; transform: translate(1176px, 66px); }
    95.19%, 100% { opacity: 0; transform: translate(1176px, 40px); }
  }
  @keyframes ds-flicker {
    from { transform: scale(1, 1); }
    to { transform: scale(0.94, 1.08); }
  }
  /* Off-screen (EmberHero's observer) or paused by the visitor (its button). */
  :global([data-offscreen] .ds *),
  :global([data-paused] .ds *) {
    animation-play-state: paused !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-camera,
    .ds :global(.ds-flame),
    .ds-rs,
    .ds-rs-ring,
    .ds-rs-title,
    .ds-rs-dot,
    .ds-rs-busy,
    .ds-rs-watch,
    .ds-digit,
    .ds-callout,
    .ds-toast,
    .ds-menu,
    .ds-menu-hl,
    .ds-pointer {
      animation: none;
    }
    /* Final frame: recording finished, notification shown. */
    .ds-toast {
      opacity: 1;
      transform: translate(1176px, 66px);
    }
    .ds-pointer {
      display: none;
    }
  }
</style>
