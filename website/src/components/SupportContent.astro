---
/** Verified platform boundary, privacy facts and where to get help. */
import { platformBoundary, privacy, windowsBoundary, windowsUpcoming } from "../content/site";
import { links, release } from "../lib/release";

const H = "h2";
---

<div class="prose">
  <H id="platforms">Platforms</H>
  <p>{platformBoundary.verified}</p>
  <p>{release.windows ? platformBoundary.windows : `${windowsUpcoming} ${windowsBoundary}`} See <a href="/help#windows">Windows help</a>.</p>
  <p>{platformBoundary.unverified}</p>

  <H id="privacy">Privacy</H>
  <ul>
    {privacy.map((item) => <li>{item}</li>)}
  </ul>

  <H id="source">Source and issues</H>
  <p>
    RecordStuff is MIT licensed. Code, design docs and the <a href={links.verificationRecord} target="_blank" rel="noopener noreferrer">verification record</a> are on <a href={links.repository} target="_blank" rel="noopener noreferrer">GitHub</a>. v{release.version} was built by CI from <a href={release.sourceCommitUrl} target="_blank" rel="noopener noreferrer"><code>{release.sourceCommitShort}</code></a>.
  </p>
  <p>
    Found a problem? <a href={links.issues} target="_blank" rel="noopener noreferrer">Open an issue</a> with the relevant log lines. To find the log, open RecordStuff and choose <em>General → Show log</em>.
  </p>
</div>
