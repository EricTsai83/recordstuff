---
/**
 * The help text (allowing the app to open, install, record, camera, edit, update, remove,
 * then the Windows installer). Headings carry ids so other pages can
 * deep-link to a section, such as Download's Open Anyway and Windows links.
 */
import PlatformSwitch from "./PlatformSwitch.astro";
import StepList from "./StepList.astro";
import {
  installSteps,
  permissionsTroubleshooting,
  removeSteps,
  retainedData,
  settings,
  updateSteps,
  windowsBoundary,
  windowsInstallSteps,
  windowsRemoveSteps,
  windowsRetainedData,
  windowsUpcoming,
  windowsUpdateSteps,
} from "../content/site";
import { links, release } from "../lib/release";

const H = "h2";
const settingsTabs = [...new Set(settings.map((row) => row.tab))];
/** Chinese in the English copy (繁體中文) is marked as such, as FeatureGrid does. */
const runs = (text: string): string[] => text.split(/(\p{Script=Han}+)/u);
---

<PlatformSwitch macIds={["open-anyway", "install", "use", "camera", "edit", "update", "remove"]} windowsIds={["windows", "windows-update", "windows-remove"]} />
<div class="prose help">
  <nav class="help-topics" aria-label="Help topics">
    <p class="topics-label">On this page</p>
    <ul data-only="mac">
      {[["open-anyway", "App blocked?"], ["install", "Install"], ["use", "Record"], ["camera", "Camera"], ["edit", "Edit"], ["update", "Update"], ["remove", "Remove"]].map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ul>
    <ul data-only="windows">
      {[["windows", "Install"], ["windows-update", "Update"], ["windows-remove", "Uninstall"]].map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ul>
  </nav>
  <div data-only="mac">
    <H id="open-anyway">App blocked by macOS?</H>
    <p>RecordStuff isn't notarized by Apple, so macOS may block it on first launch and after updates. Don't click Done; instead:</p>
    <ol>
      <li>Open <strong>System Settings → Privacy &amp; Security</strong>.</li>
      <li>Scroll to <strong>Security</strong>, click <strong>Open Anyway</strong> next to RecordStuff and confirm.</li>
    </ol>
    <p class="dim">For malware or damaged-file warnings, stop and report the issue. <a href={links.appleOpenAnyway} target="_blank" rel="noopener noreferrer">Apple’s instructions ↗</a></p>

    <H id="install">Install</H>
    <StepList steps={installSteps} />
    <div class="callout">
      <p>{permissionsTroubleshooting}</p>
    </div>

    <H id="use">Record</H>
    <ul>
      <li><strong>Start:</strong> click the menu bar icon and choose <em>Start recording</em>, or press <kbd>⇧</kbd><kbd>⌘</kbd><kbd>1</kbd>.</li>
      <li><strong>Cancel or stop:</strong> the same menu or shortcut. Cancelling during the countdown saves nothing.</li>
      <li><strong>Find recordings:</strong> click the saved notification, or choose <em>Show last recording</em> or <em>Open RecordStuff</em> from the menu. RecordStuff lists your recordings, where you can play, rename, edit, reveal or delete them.</li>
    </ul>
    <p>RecordStuff records one whole screen with system audio, and your microphone if you turn it on, to an H.264/AAC MP4. To change how, open RecordStuff (<kbd>⌥</kbd><kbd>⌘</kbd><kbd>,</kbd>):</p>
    {settingsTabs.map((tab) => (
      <div class="table-scroll" role="region" aria-label={`${tab} settings`} tabindex="0">
        <table class="settings-table">
          <caption>{tab}</caption>
          <thead><tr><th>Setting</th><th>Options</th><th>Default</th></tr></thead>
          <tbody>
            {settings.filter((row) => row.tab === tab).map((row) => (<tr><td>{row.setting}</td><td>{runs(row.options).map((run, index) => index % 2 ? <span lang="zh-Hant">{run}</span> : run)}</td><td>{row.fallback}</td></tr>))}
          </tbody>
        </table>
      </div>
    ))}
    <p>While recording, only Icon click, Language and Appearance can change, and Input device while Microphone is on.</p>

    <H id="camera">Camera</H>
    <p>RecordStuff can draw your camera into the recording as a bubble. It is part of the video only: nothing is shown on your screen, so it never covers or catches clicks meant for the app you record.</p>
    <ul>
      <li><strong>Turn it on:</strong> check <em>Camera</em> under <em>Include in recordings</em> in the menu bar menu, or turn on <em>Camera</em> in Recording settings, where <em>Camera device</em> picks the camera. macOS asks for camera access the first time.</li>
      <li><strong>If access was refused:</strong> click <em>Open camera settings…</em> and allow RecordStuff in <strong>System Settings → Privacy &amp; Security → Camera</strong>, then click <em>Already allowed? Relaunch RecordStuff</em>; macOS shows a new permission to RecordStuff only after a relaunch. While access is off, a recording with Camera on does not start.</li>
      <li><strong>Arrange it:</strong> choose <em>Open Recording Studio…</em> from the menu bar menu. Drag the bubble in the preview (or move it with the arrow keys), and set its width, height, shape, rounding and mirror. Its place is remembered for each display.</li>
      <li><strong>Check before recording:</strong> turn on <em>Live preview</em> in the Studio to see the recording as it will look, with level meters for system audio and the microphone. <em>Start recording</em> continues from it without a gap.</li>
      <li><strong>While recording:</strong> the bubble can still be moved and resized in the Studio. Choose <em>Hide camera</em> from the menu bar menu, or turn off <em>Show camera in recording</em> in the Studio, to take it out for a while; the next recording shows it again.</li>
      <li><strong>Volume:</strong> the Studio's Audio panel has a mute and a volume for system audio and for the microphone, from 0% to 600%. Mutes last for one recording; volumes are kept for the next ones.</li>
    </ul>
    <p class="dim">The camera is also offered on Windows, where desktop apps must be allowed in Settings → Privacy &amp; security → Camera; it has not been tested with a camera on Windows hardware.</p>

    <H id="edit">Edit</H>
    <p>Cut out what you don't need. The recording itself is never changed.</p>
    <ul>
      <li><strong>Cut:</strong> in RecordStuff's Recordings, open a recording's menu and choose <em>Edit…</em>. Remove parts at the start, the end or anywhere between.</li>
      <li><strong>Export:</strong> <em>Export</em> saves what is kept as a new file beside it, such as <code>Talk (edited).mp4</code>. The edit is remembered, so it reopens where you left it.</li>
      <li><strong>Editable recordings:</strong> turn on <em>Editable recordings</em> in Recording settings, or choose <em>Start editable recording</em> from the menu bar menu for one recording. The camera and each sound stay apart, so in Edit… you can still move the camera and set the volumes. Files are about twice as large, and other apps play only the screen with system audio until you export.</li>
    </ul>

    <H id="update">Update</H>
    <p>By default RecordStuff checks for updates at launch and notifies you of a new version. To install it:</p>
    <StepList steps={updateSteps} />

    <H id="remove">Remove</H>
    <StepList steps={removeSteps} />
    <div class="table-scroll" role="region" aria-label="Retained data locations" tabindex="0">
      <table>
        <thead><tr><th>Data</th><th>Location</th></tr></thead>
        <tbody>
          {retainedData.map((row) => (<tr><td>{row.data}</td><td><code>{row.location}</code></td></tr>))}
        </tbody>
      </table>
    </div>
  </div>

  <div data-only="windows">
    <H id="windows">Install<span class="platform-suffix"> on Windows</span></H>
    <p>{release.windows ? <>An x64 installer is on the <a href="/download#windows-title">Download</a> page.</> : windowsUpcoming}</p>
    <div class="callout">
      <p><strong>Not verified on Windows hardware.</strong> {windowsBoundary}</p>
    </div>
    <StepList steps={windowsInstallSteps} />

    <H id="windows-update">Update<span class="platform-suffix"> on Windows</span></H>
    <StepList steps={windowsUpdateSteps} />

    <H id="windows-remove">Uninstall<span class="platform-suffix"> on Windows</span></H>
    <StepList steps={windowsRemoveSteps} />
    <div class="table-scroll" role="region" aria-label="Retained data locations on Windows" tabindex="0">
      <table>
        <thead><tr><th>Data</th><th>Location</th></tr></thead>
        <tbody>
          {windowsRetainedData.map((row) => (<tr><td>{row.data}</td><td><code>{row.location}</code></td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
  <p class="dim">This guide is also on GitHub in <a href={links.installGuide} target="_blank" rel="noopener noreferrer">English</a> and <a href={links.installGuideZh} hreflang="zh-Hant" lang="zh-Hant" target="_blank" rel="noopener noreferrer">繁體中文</a>.</p>
</div>

<style>
  .help-topics { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); }
  .help-topics .topics-label { margin: 0 0 0.5rem; font-size: 0.85rem; color: var(--fg-muted); }
  :where(.help-topics) ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; padding: 0; margin: 0; list-style: none; }
  .help-topics li { margin: 0; }
  .help-topics a { display: inline-flex; padding: 0.4rem 0; }
  .table-scroll {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
  }
  .table-scroll table {
    margin: 0;
  }
  /* The Recording and General tables share column widths, so they read as one list. */
  .settings-table {
    table-layout: fixed;
    width: 100%;
    min-width: 36rem;
  }
  .settings-table th:nth-child(1) { width: 30%; }
  .settings-table th:nth-child(2) { width: 44%; }
  .table-scroll caption {
    text-align: left;
    font-weight: 600;
    padding-bottom: 0.5rem;
  }
</style>
