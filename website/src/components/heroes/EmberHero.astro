---
import AppleMark from "../AppleMark.astro";
import GitHubMark from "../GitHubMark.astro";
import WindowsMark from "../WindowsMark.astro";
import DesktopScene from "../DesktopScene.astro";
import { hero } from "../../content/site";
import { links, release } from "../../lib/release";

const windows = release.windows;
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title display">{hero.title}</h1>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href={release.dmgUrl} data-download-os="mac"><AppleMark size={18} /><span>{hero.primaryCta}</span></a>
      {windows && <a class="btn btn-primary btn-lg" href={windows.url} data-download-os="windows" hidden><WindowsMark size={16} /><span>{hero.windowsCta}</span></a>}
      <a class="hero-source-link" href={links.repository} target="_blank" rel="noopener noreferrer"><GitHubMark size={15} /><span>{hero.secondaryCta}</span></a>
      <p class="hero-version dim" data-download-os="mac">v{release.version} · {release.sizeLabel} · Apple silicon · <a class="link" href="/download#macos-title">checksum</a></p>
      {windows && <p class="hero-version dim" data-download-os="windows" hidden>v{release.version} · {windows.sizeLabel} · {windows.architectureLabel} · {hero.windowsNote} · <a class="link" href="/download#windows-title">details</a></p>}
      <!-- The other platform's section on /download, for a wrong guess or a download meant for another computer.
           Windows is reached through its section, where its unverified state is stated beside the installer. -->
      {windows && <a class="hero-other link" href="/download#windows-title" data-download-os="mac">{hero.otherWindows}</a>}
      {windows && <a class="hero-other link" href="/download#macos-title" data-download-os="windows" hidden>{hero.otherMac}</a>}
    </div>
    <!-- Inline so it runs while the page is parsed, before the hero paints: a Windows visitor never sees the macOS
         button first. Without scripting, on any other system or for a release without the installer, macOS stays.
         Only the system is read, never the architecture: Windows on Arm reports x64 too, and /download says it is unsupported. -->
    <script is:inline>
      (() => {
        const system = navigator.userAgentData?.platform || navigator.userAgent;
        if (!/Windows/i.test(system) || !document.querySelector('[data-download-os="windows"]')) return;
        document.querySelectorAll("[data-download-os]").forEach((el) => { el.hidden = el.dataset.downloadOs !== "windows"; });
      })();
    </script>
    <div class="hero-scene">
      <div class="scene-frame" data-scene-frame><DesktopScene /></div>
      <!-- Shown by the script below: without scripting it could not act, and reduced motion already stills the scene.
           Tucked into the scene's corner and shown on hover: WCAG 2.2.2 asks for a way to stop the loop, not for it to compete with the demo.
           Its ring fills once per loop, so it also tells how far the story has come. -->
      <button class="scene-toggle" type="button" data-scene-toggle data-pause={hero.pauseScene} data-play={hero.playScene} aria-label={hero.pauseScene} title={hero.pauseScene} hidden>
        <span class="scene-toggle-ring" aria-hidden="true"><span class="scene-toggle-progress" data-scene-progress></span></span>
        <svg class="scene-toggle-pause" viewBox="0 0 10 10" aria-hidden="true"><rect x="2" y="1.5" width="2" height="7" rx="0.5" /><rect x="6" y="1.5" width="2" height="7" rx="0.5" /></svg>
        <svg class="scene-toggle-play" viewBox="0 0 10 10" aria-hidden="true"><path d="M3 1.8v6.4a.5.5 0 0 0 .77.42l4.9-3.2a.5.5 0 0 0 0-.84l-4.9-3.2A.5.5 0 0 0 3 1.8z" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  // Save work when the scene is scrolled away: everything inside pauses.
  const frame = document.querySelector<HTMLElement>("[data-scene-frame]");
  if (frame && "IntersectionObserver" in window) {
    new IntersectionObserver(
      (entries) => entries.forEach((entry) => frame.toggleAttribute("data-offscreen", !entry.isIntersecting)),
      { threshold: 0.05 },
    ).observe(frame);
  }
  // The loop never ends on its own; a visitor can stop it, which pauses everything inside the scene.
  // Reduced motion already stills it, so the control follows that preference, also when it changes while the page is open.
  const toggle = document.querySelector<HTMLButtonElement>("[data-scene-toggle]");
  if (frame && toggle) {
    const setPaused = (paused: boolean): void => {
      frame.toggleAttribute("data-paused", paused);
      // The glyph follows data-paused in CSS; the name is what assistive technology and the tooltip read.
      const label = (paused ? toggle.dataset.play : toggle.dataset.pause) ?? "";
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
    };
    toggle.addEventListener("click", () => setPaused(!frame.hasAttribute("data-paused")));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const follow = (): void => {
      toggle.hidden = reduced.matches;
      // Coming back from reduced motion starts the loop again, so the control must read Pause.
      if (reduced.matches) setPaused(false);
    };
    // The ring takes its length and position from the scene's own clock, so the loop's timing lives in
    // DesktopScene alone; once aligned, both pause and resume on the same attribute changes and stay together.
    const progress = toggle.querySelector<HTMLElement>("[data-scene-progress]");
    const clock = frame.querySelector<SVGElement>(".ds-camera");
    const syncProgress = (): void => {
      if (!progress || !clock) return;
      progress.style.animationDuration = getComputedStyle(clock).animationDuration;
      const [lead] = clock.getAnimations();
      const [ring] = progress.getAnimations();
      if (lead && ring) ring.currentTime = lead.currentTime;
    };
    follow();
    syncProgress();
    reduced.addEventListener("change", () => {
      follow();
      // Leaving reduced motion restarts the scene and reveals the ring, so both begin a new loop.
      if (!reduced.matches) syncProgress();
    });
  }
</script>

<style>
  /*
   * No overflow: hidden here. The scene below carries a 100 px drop shadow that
   * reaches past the hero's padding, and clipping it drew a hard horizontal
   * seam across the page right under the demo.
   */
  .hero {
    position: relative;
    padding: calc(var(--section-y) * 1.5) 0 var(--section-y);
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }
  .hero-title {
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    max-width: 24ch;
    text-wrap: balance;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .hero-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .hero-source-link:hover {
    color: var(--fg);
  }
  .hero-version,
  .hero-other {
    font-size: 0.85rem;
  }
  /* Read as one block with the version line above it. */
  .hero-other {
    margin-top: -0.55rem;
  }
  /* .btn sets display, which would otherwise outrank the hidden attribute. */
  .hero-actions [hidden] {
    display: none;
  }
  .hero-scene {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin-top: 0.5rem;
  }
  /*
   * Over the scene's bottom-right corner, where the demo has only dark trees,
   * and invisible until the pointer is over the scene. Keyboard focus shows it
   * too, so Tab never lands on something unseen, and so does a paused scene,
   * so the way back to playing stays in view. Touch screens cannot hover, so
   * there it simply stays. The dark disc keeps the glyph readable on any
   * frame of the scene; the 28 px box clears the 24 px minimum target (2.5.8).
   */
  .scene-toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(9, 9, 11, 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--fg-muted);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.2s ease-out,
      color 0.15s ease;
  }
  .hero-scene:hover .scene-toggle,
  .scene-toggle:focus-visible,
  [data-paused] + .scene-toggle {
    opacity: 1;
  }
  @media (hover: none) {
    .scene-toggle {
      opacity: 1;
    }
  }
  .scene-toggle[hidden] {
    display: none;
  }
  .scene-toggle:hover,
  .scene-toggle:focus-visible {
    color: var(--fg);
  }
  .scene-toggle-pause,
  .scene-toggle-play {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }
  /*
   * The ring doubles as the button's edge: a faint track, and over it an arc
   * that grows from twelve o'clock through one loop of the scene. Linear, so
   * the arc reads as elapsed time. The script sets the duration from the
   * scene; it stops with the scene, off-screen or paused.
   *
   * The arc is a full ring revealed by a conic mask whose edge fades over 16°.
   * One loop moves the tip only a few pixels a second, and a hard tip lit one
   * pixel after another, so it seemed to tick; the fade spreads each step over
   * the pixels behind the tip, which brighten together. The mask sweeps past
   * 360° by the fade's width, so the ring closes as the loop ends. The 0.25 px
   * inset keeps the ring just inside the disc's edge.
   */
  @property --scene-sweep {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  .scene-toggle-ring {
    position: absolute;
    inset: 0.25px;
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
  }
  .scene-toggle-progress {
    position: absolute;
    inset: -1.5px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    -webkit-mask: conic-gradient(#000 calc(var(--scene-sweep) - 16deg), transparent var(--scene-sweep));
    mask: conic-gradient(#000 calc(var(--scene-sweep) - 16deg), transparent var(--scene-sweep));
    animation: scene-progress linear infinite;
  }
  [data-offscreen] + .scene-toggle .scene-toggle-progress,
  [data-paused] + .scene-toggle .scene-toggle-progress {
    animation-play-state: paused;
  }
  @keyframes scene-progress {
    to {
      --scene-sweep: 376deg;
    }
  }
  .scene-toggle-play,
  [data-paused] + .scene-toggle .scene-toggle-pause {
    display: none;
  }
  [data-paused] + .scene-toggle .scene-toggle-play {
    display: block;
  }
  .scene-frame {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 138, 61, 0.08);
    overflow: hidden;
    line-height: 0;
  }
  /*
   * The headline, the buttons and the version line are simply there on the
   * first frame: no entrance, nothing to wait through before the page can be
   * read. Only the demo moves, lifting into place under text that is already
   * settled, and it starts right away so the motion belongs to the page
   * arriving rather than arriving after it. The hero is above the fold on
   * every screen, so it runs itself instead of waiting for the scroll reveal
   * the rest of the page uses. Armed only once Layout.astro has set
   * data-motion: without scripting the demo is in place from the first frame.
   *
   * Two animations, because the lift has to outlast the fade: with one, the
   * frame went fully opaque a third of the way up and the travel that was
   * meant to read as floating happened after the eye had stopped watching.
   */
  :global(:root[data-motion="on"]) .hero-scene {
    animation:
      hero-lift 0.6s cubic-bezier(0.215, 0.61, 0.355, 1) 0.06s both,
      hero-fade 0.45s cubic-bezier(0.4, 0, 0.2, 1) 0.06s both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hero-lift {
    from {
      transform: translateY(36px);
    }
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-motion="on"]) .hero-scene {
      animation: none;
    }
  }

</style>
