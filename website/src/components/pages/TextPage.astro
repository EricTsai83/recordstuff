---
/** Shared reading layout for the Download, Help and Support pages. */
interface Props {
  title: string;
  description: string;
  narrow?: boolean;
}
const { title, description, narrow = false } = Astro.props;
---

<article class:list={["text-page", "container", { "text-page--guide": narrow }]}>
  <header class="text-head">
    <h1 class="display">{title}</h1>
    <p class="intro">{description}</p>
    <slot name="meta" />
  </header>
  <div class="reading-layout">
    <div class="reading-content"><slot /></div>
  </div>
</article>

<style>
  .text-page { max-width: 1120px; padding: 5rem 32px 6rem; }
  .text-head { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; margin-bottom: 4.5rem; }
  .text-head h1 { max-width: 850px; font-size: clamp(2.3rem, 4.8vw, 3.8rem); line-height: 1.1; text-wrap: balance; }
  .intro { max-width: 620px; font-size: 1.05rem; line-height: 1.75; color: var(--fg-muted); text-wrap: pretty; }
  .reading-layout { padding-top: 3.5rem; }
  .text-page--guide .text-head,
  .text-page--guide .reading-content {
    max-width: 800px;
    margin-inline: auto;
  }
  .reading-content { min-width: 0; }
  .reading-content :global(.prose) { line-height: 1.8; }
  .reading-content :global(.prose > h2) { margin: 4.5rem 0 1.75rem; padding-top: 3.5rem; border-top: 1px solid var(--border); font-size: 1.55rem; line-height: 1.3; }
  .reading-content :global(.prose > h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .reading-content :global(.prose p) { margin-bottom: 1.25rem; }
  .reading-content :global(.prose li) { margin-bottom: 1rem; }
  .reading-content :global(.prose .steps) { padding-left: 0; margin: 2.25rem 0; gap: 0; }
  .reading-content :global(.prose .step) { margin: 0; padding: 2rem 0; border: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: none; grid-template-columns: 1.8rem minmax(0, 1fr); }
  .reading-content :global(.prose .step-title) { margin: 0 0 0.5rem; line-height: 1.5; }
  .reading-content :global(.prose .step-body p) { margin: 0; }
  .reading-content :global(.callout) { padding: 0 0 0 1.25rem; margin: 2.75rem 0; border: 0; border-left: 2px solid var(--warn); border-radius: 0; background: none; }
  .reading-content :global(.callout p:last-child) { margin-bottom: 0; }
  .reading-content :global(.prose th), .reading-content :global(.prose td) { padding: 1rem; font-size: 0.85rem; }
  .reading-content :global(.prose th) { background: none; }
  @media (max-width: 640px) {
    .text-page { padding: 3rem 20px 4rem; }
    .text-head { gap: 1rem; margin-bottom: 3rem; }
    .reading-layout { padding-top: 2.5rem; }
    .reading-content :global(.prose > h2) { margin-top: 3.5rem; padding-top: 2.75rem; }
    .reading-content :global(.prose .step) { padding: 1.75rem 0; gap: 0.5rem; grid-template-columns: 1.5rem minmax(0, 1fr); }
    .reading-content :global(.callout) { padding: 0 0 0 1rem; }
    .reading-content :global(.prose th), .reading-content :global(.prose td) { padding: 0.75rem 0.6rem; }
  }
</style>
